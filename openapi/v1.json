  "components": {
    "schemas": {
      "CatalogResponse": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "lakehouse": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lakehouse"
          },
          "catalog_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Catalog Type"
          },
          "warehouse": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Warehouse"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "connected"
        ],
        "title": "CatalogResponse",
        "description": "Non-secret catalog view. Write path is ``CatalogSpec``."
      },
      "CreateSessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id"
        ],
        "title": "CreateSessionResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "description": "Client-facing error returned by REST and SSE boundaries."
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "INVALID_ARGUMENT",
          "INVALID_TYPE",
          "NOT_FOUND",
          "ALREADY_EXISTS",
          "UNAUTHENTICATED",
          "PERMISSION_DENIED",
          "CONNECTION_FAILED",
          "CONNECTION_TIMEOUT",
          "UNAVAILABLE",
          "KEYRING",
          "JSON",
          "INFERENCE_FAILED",
          "RATE_LIMITED",
          "MODEL_NOT_FOUND",
          "INTERNAL"
        ],
        "title": "ErrorCode",
        "description": "Stable, machine-readable error identifiers.\n\nSubclasses ``str`` so a code serializes as its plain value in JSON payloads.\nThe set is intentionally scoped to lakegen's real failure modes (agent\ninput, resource state, catalog connectivity/auth, credential storage) rather\nthan a generic status taxonomy."
      },
      "GlueCatalogSpec": {
        "properties": {
          "lakehouse": {
            "type": "string",
            "const": "iceberg",
            "title": "Lakehouse",
            "description": "Lakehouse type. Use 'iceberg'."
          },
          "catalog_type": {
            "type": "string",
            "const": "glue",
            "title": "Catalog Type",
            "description": "Catalog backend. Use 'glue'.",
            "default": "glue"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Unique name for this connection."
          },
          "access_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Access Key",
            "description": "S3 access key ID."
          },
          "secret_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Secret Key",
            "description": "S3 secret access key."
          },
          "region": {
